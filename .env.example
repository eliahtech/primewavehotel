# ── Required ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, never expose to a browser
JWT_SECRET=                     # >= 32 random chars (openssl rand -hex 32). App refuses to start without it.
CRON_SECRET=                    # random string; Vercel sends it as "Authorization: Bearer ..." to /api/cron/*

# ── Public URL (needed for PesaPal callbacks + email links) ──
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL, but set it explicitly for a custom domain.
PUBLIC_BASE_URL=https://your-domain.com

# ── PesaPal ────────────────────────────────────────────────
PESAPAL_ENV=sandbox             # sandbox | live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=                 # REQUIRED on Vercel: run once locally/with /api/cron/register-ipn then paste the id

# ── Chat assistant ─────────────────────────────────────────
GROQ_API_KEY=

# ── Hotel details ──────────────────────────────────────────
HOTEL_NAME=PrimeWave Hotel
ADMIN_EMAIL=
ADMIN_PHONE=

# ── SMTP (blank = emails are only logged) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Local dev only ─────────────────────────────────────────
PORT=3000
